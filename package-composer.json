{
  "name": "nosun/laravel-exception-center-client",
  "description": "Fail-safe structured exception reporting and processing primitives.",
  "type": "library",
  "require": {
    "php": ">=8.4"
  },
  "autoload": {
    "psr-4": {
      "Nosun\\ExceptionCenter\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Nosun\\ExceptionCenter\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "php tests/run.php"
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "extra": {
    "laravel": {
      "providers": [
        "Nosun\\ExceptionCenter\\Support\\ExceptionCenterServiceProvider"
      ]
    }
  },
  "version": "dev-main"
}
